CARGO_TERM_COLOR=always
NODE_VERSION=22.x
PROGRAMS=["mpl-project-name"]
RUST_VERSION=1.83.0
SOLANA_VERSION=2.2.1
COMMIT_USER_NAME=github-actions
COMMIT_USER_EMAIL=github-actions@github.com
DEPLOY_SOLANA_VERSION=2.2.1
SOLANA_VERIFY_VERSION=0.4.15
# solana-verify is built from source and needs Rust 1.85+, newer than the program toolchain above.
SOLANA_VERIFY_RUST_VERSION=1.85.0
# Verifiable-build image to use (must be listed in metaplex-foundation/actions solana-verify-base-images.json).
SOLANA_VERIFY_BUILD_VERSION=2.3.5
# shank-js installs the newest shank-cli matching the program's shank dependency; shank-cli 0.4.5 pulls in
# crates that need rustc 1.88. Only the IDL generation job uses this toolchain.
IDL_RUST_VERSION=1.88.0
